#!/usr/bin/with-contenv bashio

export MQTT_HOST=$(bashio::config 'mqtt_host')
export MQTT_PORT=$(bashio::config 'mqtt_port')
export MQTT_USER=$(bashio::config 'mqtt_user')
export MQTT_PASSWORD=$(bashio::config 'mqtt_password')
export PRODUCT_ID=$(bashio::config 'product_id')
export DEVICE_ID=$(bashio::config 'device_id')
export HA_DISCOVERY=$(bashio::config 'ha_discovery')
export HA_PREFIX=$(bashio::config 'ha_prefix')
export POLL_INTERVAL=$(bashio::config 'poll_interval')

bashio::log.info "Starting SolarFlow Hyper transformer..."
bashio::log.info "MQTT: ${MQTT_HOST}:${MQTT_PORT}"
bashio::log.info "Device: ${PRODUCT_ID}/${DEVICE_ID}"
bashio::log.info "HA Discovery: ${HA_DISCOVERY}"
bashio::log.info "Poll interval: ${POLL_INTERVAL}s"

exec python3 /usr/bin/solarflow-hyper.py
